# Export these variables in your shell; this file is not automatically loaded.
RAG_DATA_DIR=.data
RAG_PROVIDER=extractive

# Optional local generated answers. Set a model already installed in Ollama.
# RAG_PROVIDER=ollama
# RAG_BASE_URL=http://127.0.0.1:11434
# RAG_MODEL=your-installed-model

# Optional Chat Completions-compatible provider (base includes /v1).
# RAG_PROVIDER=compatible
# RAG_BASE_URL=https://your-provider.example/v1
# RAG_MODEL=your-model-id
# RAG_API_KEY=your-key

# Optional models; install with uv sync --extra semantic first.
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
